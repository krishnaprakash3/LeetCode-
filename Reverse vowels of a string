class Solution {
    public String reverseVowels(String s) {
        String str="";
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u'||c=='A'||c=='E'||c=='I'||c=='O'||c=='U'){
                str=str+c;
            }
        }
        String st="";
        for(int i=str.length()-1;i>=0;i--){
            st=st+str.charAt(i);
        }
        String res="";
        int j=0;
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
             if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u'||c=='A'||c=='E'||c=='I'||c=='O'||c=='U'){
                res=res+st.charAt(j);
                j++;
            }else{
                res=res+c;
            }

        }
        return res;
    }
}
